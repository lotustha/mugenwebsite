generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model App {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String?         @unique
  name          String
  tagline       String?
  description   String?         @db.Text
  category      String?
  iconUrl       String?         @map("icon_url")
  bannerUrl     String?         @map("banner_url")
  videoUrl      String?         @map("video_url")
  privacyPolicy String?         @db.Text @map("privacy_policy")
  version       String
  size          String?
  packageName   String?         @map("package_name")
  published     Boolean         @default(true)
  featured      Boolean         @default(false)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  links         AppLink[]
  screenshots   AppScreenshot[]
  faqs          AppFaq[]

  @@map("apps")
}

model AppLink {
  id       String @id @default(uuid()) @db.Uuid
  appId    String @map("app_id") @db.Uuid
  platform String
  url      String
  app      App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("app_links")
}

model AppScreenshot {
  id      String  @id @default(uuid()) @db.Uuid
  appId   String  @map("app_id") @db.Uuid
  url     String
  caption String?
  order   Int     @default(0)
  app     App     @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("app_screenshots")
}

model AppFaq {
  id       String @id @default(uuid()) @db.Uuid
  appId    String @map("app_id") @db.Uuid
  question String
  answer   String @db.Text
  order    Int    @default(0)
  app      App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("app_faqs")
}

model User {
  id          String      @id @default(uuid()) @db.Uuid
  email       String      @unique
  password    String?
  role        Role        @default(USER)
  // ─── Public social profile (nullable; backfilled on first social visit) ───
  username    String?     @unique                 // public handle for /u/[username]
  displayName String?     @map("display_name")
  avatar      String?                             // absolute or /uploads/* URL
  bio         String?     @db.Text
  verified    Boolean     @default(false)         // admin-granted blue tick (paid tier later)
  lastSeenAt  DateTime?    @map("last_seen_at")    // presence heartbeat → online dot
  posts       Post[]
  wallpapers  Wallpaper[]
  createdAt   DateTime    @default(now()) @map("created_at")

  // ─── Auth.js (Google OAuth via PrismaAdapter; session strategy stays JWT) ──
  accounts    Account[]
  sessions    Session[]   // unused at runtime (JWT strategy); kept for adapter compat

  // ─── Social graph ─────────────────────────────────────────────────────────
  socialPosts      SocialPost[]
  comments         Comment[]
  likes            Like[]
  following        Follow[]          @relation("follower")  // rows where I am the follower
  followers        Follow[]          @relation("following") // rows where I am followed
  discussions      Discussion[]
  discussionReplies DiscussionReply[]
  notifications    Notification[]    @relation("recipient") // notifications I receive
  actorNotifications Notification[]  @relation("actor")     // notifications I triggered

  @@map("users")
}

enum Role {
  USER
  AUTHOR
  ADMIN
}

model Post {
  id                String     @id @default(uuid()) @db.Uuid
  title             String
  slug              String     @unique
  summary           String
  content           String     @db.Text
  featuredImage     String?    @map("featured_image")
  featuredImageAlt  String?    @map("featured_image_alt")
  authorId          String     @map("author_id") @db.Uuid
  author            User       @relation(fields: [authorId], references: [id])
  published         Boolean    @default(false)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  categories        Category[]
  tags              Tag[]
  seoMeta           SeoMeta?

  @@map("posts")
}

model Category {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("categories")
}

model Tag {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("tags")
}

model SeoMeta {
  id              String  @id @default(uuid()) @db.Uuid
  postId          String  @unique @map("post_id") @db.Uuid
  post            Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  metaTitle       String  @map("meta_title")
  metaDescription String  @map("meta_description")
  ogImageUrl      String? @map("og_image_url")
  canonicalUrl    String? @map("canonical_url")
  keywords        String? @map("keywords")

  @@map("seo_meta")
}

model Wallpaper {
  id             String              @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  fileUrl        String              @map("file_url")
  type           WallpaperType
  uploaderId     String              @map("uploader_id") @db.Uuid
  uploader       User                @relation(fields: [uploaderId], references: [id])
  downloadsCount Int                 @default(0) @map("downloads_count")
  createdAt      DateTime            @default(now()) @map("created_at")
  categories     WallpaperCategory[]
  tags           WallpaperTag[]

  @@map("wallpapers")
}

enum WallpaperType {
  IMAGE
  VIDEO
}

model WallpaperCategory {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  slug       String      @unique
  wallpapers Wallpaper[]
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("wallpaper_categories")
}

model WallpaperTag {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  slug       String      @unique
  wallpapers Wallpaper[]

  @@map("wallpaper_tags")
}

model RssFeed {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  url             String
  sourceType      RssSourceType  @default(RSS) @map("source_type")
  maxItems        Int            @default(3)  @map("max_items")          // AI_SCRAPE only — how many articles per run
  scheduleMinutes Int            @default(60)  @map("schedule_minutes") // 30 | 60 | 1440 | etc.
  isActive        Boolean        @default(true) @map("is_active")
  autoPublish     Boolean        @default(false) @map("auto_publish")
  lastRunAt       DateTime?      @map("last_run_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  logs            RssImportLog[]

  @@map("rss_feeds")
}

enum RssSourceType {
  RSS         // Standard RSS/Atom XML feed
  AI_SCRAPE   // Plain webpage URL; AI extracts article list + per-article content
}

model RssImportLog {
  id          String   @id @default(uuid()) @db.Uuid
  feedId      String   @map("feed_id") @db.Uuid
  feed        RssFeed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  itemGuid    String   @map("item_guid")       // original RSS guid/link — deduplication key
  postId      String?  @map("post_id") @db.Uuid // null if skipped/failed
  status      String   @default("ok")           // "ok" | "skipped" | "error"
  errorMsg    String?  @map("error_msg")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([feedId, itemGuid])
  @@map("rss_import_logs")
}

model SystemSetting {
  key   String @id
  value String @db.Text

  @@map("system_settings")
}

// ─── In-App Messaging ────────────────────────────────────────────────────────

model InAppMessage {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String   @db.Text
  imageUrl    String?  @map("image_url")
  buttonText  String?  @map("button_text")
  buttonUrl   String?  @map("button_url")   // URL or deep link e.g. mugenanime://post/slug
  style       String   @default("info")      // info | warning | promo | alert
  targetApp   String?  @map("target_app")    // app slug — null means all apps
  persistent  Boolean  @default(false)       // show on every launch until button clicked
  cancelable  Boolean  @default(true)        // false = MUST click button to dismiss
  active      Boolean  @default(true)
  priority    Int      @default(0)           // higher = shown first when multiple messages
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime @default(now())  @map("created_at")
  updatedAt   DateTime @updatedAt       @map("updated_at")

  impressions InAppImpression[]
  clicks      InAppClick[]

  @@map("in_app_messages")
}

model InAppImpression {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  message   InAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId  String?     @map("device_id")
  seenAt    DateTime    @default(now()) @map("seen_at")

  @@map("in_app_impressions")
}

model InAppClick {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  message   InAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId  String?     @map("device_id")
  clickedAt DateTime    @default(now()) @map("clicked_at")

  @@map("in_app_clicks")
}

model FcmToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  platform  String   @default("android") // android | ios
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fcm_tokens")
}

// ─── Auth.js OAuth adapter tables ────────────────────────────────────────────
// PrismaAdapter persists Google sign-ins into the User table. Session strategy
// stays "jwt" (Credentials provider requires it), so the Session model below is
// kept only for adapter type-compatibility and is unused at runtime.

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── MugenSocial: posts, reels, comments, likes, follow, discussions, notifs ──

enum SocialPostType {
  IMAGE
  VIDEO
  REEL    // short-form vertical video
  TEXT    // caption-only status post (no media)
}

enum SocialPostStatus {
  PROCESSING // media uploaded, ffmpeg transcode in progress
  READY
  FAILED
}

model SocialPost {
  id          String           @id @default(uuid()) @db.Uuid
  authorId    String           @map("author_id") @db.Uuid
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type        SocialPostType
  status      SocialPostStatus @default(READY) // IMAGE posts ready immediately; video starts PROCESSING
  caption     String?          @db.Text
  mediaUrl    String?          @map("media_url")   // image or transcoded video (relative /uploads/*)
  posterUrl   String?          @map("poster_url")  // video thumbnail from ffmpeg
  durationSec Int?             @map("duration_sec")
  width       Int?
  height      Int?
  animeTag    String?          @map("anime_tag")   // free-text anime/manga title tag
  // Internal repost (share). A repost points at the original post.
  repostOfId  String?          @map("repost_of_id") @db.Uuid
  repostOf    SocialPost?      @relation("reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts     SocialPost[]     @relation("reposts")
  likesCount  Int              @default(0) @map("likes_count")
  commentsCount Int            @default(0) @map("comments_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  comments    Comment[]
  likes       Like[]

  @@index([authorId, createdAt])
  @@index([type, status, createdAt])
  @@map("social_posts")
}

model Comment {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @map("post_id") @db.Uuid
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String     @map("author_id") @db.Uuid
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String     @db.Text
  parentId  String?    @map("parent_id") @db.Uuid  // threaded replies
  parent    Comment?   @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("commentThread")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @map("post_id") @db.Uuid
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("likes")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @map("following_id") @db.Uuid
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Discussion {
  id           String            @id @default(uuid()) @db.Uuid
  title        String
  content      String            @db.Text
  authorId     String            @map("author_id") @db.Uuid
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  animeTag     String?           @map("anime_tag")
  replyCount   Int               @default(0) @map("reply_count")
  lastActiveAt DateTime          @default(now()) @map("last_active_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  replies      DiscussionReply[]

  @@index([lastActiveAt])
  @@index([animeTag, lastActiveAt])
  @@map("discussions")
}

model DiscussionReply {
  id           String           @id @default(uuid()) @db.Uuid
  discussionId String           @map("discussion_id") @db.Uuid
  discussion   Discussion       @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String           @map("author_id") @db.Uuid
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content      String           @db.Text
  parentId     String?          @map("parent_id") @db.Uuid // nested replies
  parent       DiscussionReply? @relation("replyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children     DiscussionReply[] @relation("replyThread")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([discussionId, createdAt])
  @@map("discussion_replies")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  REPLY
  REPOST
  MENTION
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid          // recipient
  user      User             @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?          @map("actor_id") @db.Uuid          // who triggered it
  actor     User?            @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  entityId  String?          @map("entity_id") @db.Uuid         // post/comment/discussion id
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, read, createdAt])
  @@map("notifications")
}

